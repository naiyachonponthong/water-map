APP_NAME="ศูนย์ช่วยเหลือน้ำท่วม"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000
# Optional absolute path to a trusted CA bundle when PHP has no trust store.
WEATHER_CA_BUNDLE=
APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=floodthai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# LINE Login (สร้าง channel ที่ developers.line.biz ประเภท LINE Login)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK="${APP_URL}/auth/line/callback"

# บัญชีผู้ดูแลระบบสูงสุดที่สร้างตอน seed
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=

# Realtime (Laravel Reverb) ตั้ง BROADCAST_CONNECTION=reverb แล้วรัน php artisan reverb:start
# ถ้ายังไม่เปิด (null) หน้าจอจะดึงข้อมูลใหม่ทุก 20 วินาทีแทน
BROADCAST_CONNECTION=null
REVERB_APP_ID=floodthai
REVERB_APP_KEY=floodthai-key
REVERB_APP_SECRET=change-this-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ขึ้นเซิร์ฟเวอร์จริง (ดู docs/DEPLOY.md)
TRUSTED_PROXIES=127.0.0.1
PII_RETENTION_DAYS=180
REQUIRE_2FA_ROLES=super-admin,province-admin,dispatcher
IDLE_TIMEOUT_MIN=120
